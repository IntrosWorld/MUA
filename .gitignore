# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.conda/
*.conda/

# ── Models (large binary files — re-download with snapshot_download) ──────────
models/

# ── Outputs (generated at runtime) ───────────────────────────────────────────
outputs/

# ── Uploads (user-uploaded audio files) ──────────────────────────────────────
uploads/

# ── Data: keep structure and demo files, ignore generated runtime data ────────
data/profiles/*.json
data/generated/*.wav
data/mixed/*.wav
data/noise/*.wav
data/ground_truth/*.wav
data/ground_truth/*.json
!data/mixed/demo_mixed.wav
!data/mixed/demo_mixed_ground_truth.json
!data/mixed/mixed.wav
!data/mixed/mixed_ground_truth.json

# ── Enrolled speaker voice recordings (privacy — user audio, re-enroll locally) ──
data/enrolled_speakers/**/*.wav
data/enrolled_speakers/**/*.mp3
data/enrolled_speakers/**/*.npy

# ── LLM / API config (may contain keys) ──────────────────────────────────────
data/llm_config.json

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
server.log
server_err.log
ov_convert*.log

# ── Large installer / archive files ──────────────────────────────────────────
*.exe
*.iso
*.zip
*.tar.gz
*.whl

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
.cursor/
*.suo
*.user

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Environment variables / secrets ──────────────────────────────────────────
.env
.env.*
secrets.json

# Desktop development and verification
node_modules/
desktop-dist/
test-results/
.runtime/
